create_clock -name sys_clk -period 20.000 [get_ports {sys_clk}]
create_clock -name eth_rx_clk -period 8.000 [get_ports {E_RXC}]
create_clock -name clk_hdmi -period 13.468 [get_nets {hdmi_clk}]
# =============================================================
# 修正后的 EDC 约束 - 使用标准 get_cells
# =============================================================

# 1. 设置最大延迟约束，强制编译器优化视频路径，防止被以太网抢占资源
# 在标准 SDC 中，我们使用 get_cells 来匹配模块实例名
set_max_delay -from [get_cells {*u_sdram_top*}] -to [get_cells {*u_image_processing*}] 13.0
set_max_delay -from [get_cells {*u_image_processing*}] -to [get_cells {*u_hdmi_top*}] 13.0

# 2. 彻底切断以太网和视频之间的所有路径，让编译器完全放弃它们之间的时序计算
# 这能释放出大量的布线资源给视频链路，解决绿色噪点
set_false_path -from [get_clocks {eth_rx_clk}] -to [get_clocks {sys_clk clk_hdmi}]
set_false_path -from [get_clocks {sys_clk clk_hdmi}] -to [get_clocks {eth_rx_clk}]