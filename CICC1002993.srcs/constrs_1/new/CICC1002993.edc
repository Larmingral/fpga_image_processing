create_clock -period 20.000 -name {sys_clk} -waveform {0.000 10.000} [get_ports {sys_clk~I}] -add
create_clock -period 14.000 -name {cam_pclk} -waveform {0.000 7.000} [get_ports {cam_pclk~I}] -add
create_generated_clock -name {grey_clk} -source [get_pins {\pll_hdmi_inst|altpll_component|pll/clk[0]}] -divide_by 3 -master_clock [get_clocks {\pll_hdmi:pll_hdmi_inst|altpll:altpll_component|_clk0}] [get_pins {\u_resolution|gray_clk~I/clk}]
create_generated_clock -name {iic_scl} -source [get_pins {\pll_hdmi_inst|altpll_component|pll/clk[0]}] -divide_by 200 -master_clock [get_clocks {\pll_hdmi:pll_hdmi_inst|altpll:altpll_component|_clk0}] [get_pins {\u_hdmi_top|u_sil9134_dri|inst_i2c_sil9134_dri|scl~I/clk}]
create_generated_clock -name {iic_dri_clk} -source [get_pins {\pll_hdmi_inst|altpll_component|pll/clk[0]}] -divide_by 50 -master_clock [get_clocks {\pll_hdmi:pll_hdmi_inst|altpll:altpll_component|_clk0}] [get_pins {\u_hdmi_top|u_sil9134_dri|inst_i2c_sil9134_dri|dri_clk~I/clk}]
set_false_path -from [get_clocks {\pll_hdmi:pll_hdmi_inst|altpll:altpll_component|_clk0}] -to [get_clocks {\resolution:u_resolution|gray_clk}]
set_false_path -from [get_clocks {\resolution:u_resolution|gray_clk}] -to [get_clocks {\TOP:u_TOP|nextstep}]
set_false_path -from [get_clocks {\TOP:u_TOP|conv_TOP:conv|STOP}] -to [get_clocks {\resolution:u_resolution|gray_clk}]
set_clock_groups -group [get_clocks {\pll_clk:u_pll_clk|altpll:altpll_component|_clk0}] -group [get_clocks {cam_pclk}]
set_clock_groups -group [get_clocks {\ov5640_top:ov5640_top_inst|i2c_ctrl:i2c_ctrl_inst|i2c_clk}] -group [get_clocks {cam_pclk}]
set_false_path -from [get_ports {E_RXD[*] E_RXDV}]
